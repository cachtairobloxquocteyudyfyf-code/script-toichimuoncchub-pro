-- Fly Hack
btnFly.MouseButton1Click:Connect(function()
    isFlyActive = not isFlyActive
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart

    if isFlyActive then
        btnFly.Text = "Fly: BẬT"
        btnFly.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FlyVelocity"
        bv.Parent = root
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)

        local bg = Instance.new("BodyGyro")
        bg.Name = "FlyGyro"
        bg.Parent = root
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = root.CFrame

        task.spawn(function()
            while isFlyActive do
                pcall(function()
                    char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        root = char.HumanoidRootPart
                        bv = root:FindFirstChild("FlyVelocity")
                        bg = root:FindFirstChild("FlyGyro")
                        if bv and bg then
                            bg.CFrame = workspace.CurrentCamera.CFrame
                            bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * flySpeed
                        end
                    end
                end)
                task.wait()
            end
            pcall(function()
                if root:FindFirstChild("FlyVelocity") then root.FlyVelocity:Destroy() end
                if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
            end)
        end)
    else
        btnFly.Text = "Fly: TẮT"
        btnFly.BackgroundColor3 = Color3.fromRGB(180, 100, 0)
        pcall(function()
            if root:FindFirstChild("FlyVelocity") then root.FlyVelocity:Destroy() end
            if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
        end)
    end
end)

