-- WalkSpeed Safe (Chống Kick)
SpeedBox.FocusLost:Connect(function()
    pcall(function()
        local num = tonumber(SpeedBox.Text)
        if num then
            if num < 16 then num = 16 end
            if num > 80 then num = 80 end
            SpeedBox.Text = tostring(num)
            if speedConnection then speedConnection:Disconnect() end
            speedConnection = RunService.Heartbeat:Connect(function(delta)
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum.MoveDirection.Magnitude > 0 then
                            char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + (hum.MoveDirection * (num - hum.WalkSpeed) * delta)
                        end
                    end
                end)
            end)
        end
    end)
end)

-- Fly V3 Safe
local flyBV, flyBG
FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if isFlying then
        FlyBtn.Text = _T("FlyOn") FlyBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        flyBV = Instance.new("BodyVelocity", hrp) flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9) flyBV.Velocity = Vector3.new(0, 0.1, 0)
        flyBG = Instance.new("BodyGyro", hrp) flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9) flyBG.CFrame = hrp.CFrame
        
        flyConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and flyBV and flyBG then
                    flyBG.CFrame = Camera.CFrame
                    local moveDir = hum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        flyBV.Velocity = (Camera.CFrame.LookVector * moveDir.Z * -flySpeed) + (Camera.CFrame.RightVector * moveDir.X * flySpeed)
                    else
                        flyBV.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end)
        end)
    else
        FlyBtn.Text = _T("FlyOff") FlyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyBG then flyBG:Destroy() flyBG = nil end
    end
end)

