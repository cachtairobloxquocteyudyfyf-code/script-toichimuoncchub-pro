-- Tìm tên Player để bám
TargetBox:GetPropertyChangedSignal("Text"):Connect(function()
    pcall(function()
        local textName = string.lower(TargetBox.Text)
        if textName == "" then
            AvatarImg.Image = "rbxassetid://0"
            currentTargetPlayer = nil
            return
        end
        local found = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (string.find(string.lower(p.Name), textName) or string.find(string.lower(p.DisplayName), textName)) then
                found = p
                break
            end
        end
        if found then
            currentTargetPlayer = found
            AvatarImg.Image = Players:GetUserThumbnailAsync(found.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            StatusLbl.Text = "Đã chọn: " .. found.Name .. " ✅"
        else
            AvatarImg.Image = "rbxassetid://0"
            currentTargetPlayer = nil
        end
    end)
end)

