-- Logic hệ thống phụ trợ & Anti-AFK chuẩn
local currentTargetPlayer = nil
local isTweenRunning, isFlying, isEspRunning, isFullbrightRunning, isAntiAfkRunning = false, false, false, false, true
local tweenConnection, flyConnection, espConnection, speedConnection, afkConnection
local flySpeed = 50
local espDrawings = {}

local oldBrightness = Lighting.Brightness
local oldClockTime = Lighting.ClockTime
local oldFogEnd = Lighting.FogEnd
local oldGlobalShadows = Lighting.GlobalShadows

-- Thời gian & Ping/FPS
local scriptStartTime = tick()
task.spawn(function()
    while true do
        pcall(function()
            local elapsed = math.floor(tick() - scriptStartTime)
            ScriptTimeLabel.Text = string.format("⏱️ Time: %02d:%02d:%02d", math.floor(elapsed/3600), math.floor((elapsed%3600)/60), elapsed%60)
            local pingMs = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            local fpsVal = math.floor(1 / RunService.RenderStepped:Wait())
            NetworkStatsLabel.Text = string.format("📡 Ping: %d ms | 🖥️ FPS: %d", pingMs, fpsVal)
        end)
        task.wait(1)
    end
end)

-- Logic Anti-AFK Bật/Tắt hoàn chỉnh
afkConnection = LocalPlayer.Idled:Connect(function()
    if isAntiAfkRunning then
        pcall(function()
            VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        end)
    end
end)

