-- 8. Logic WalkSpeed
local function applySpeed(val)
    currentSpeed = val
    btnSpeed16.BackgroundColor3 = (val == 16) and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(50, 150, 50)
    btnSpeed50.BackgroundColor3 = (val == 50) and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(50, 150, 50)
    btnSpeed100.BackgroundColor3 = (val == 100) and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(150, 100, 0)
    
    pcall(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = val
        end
    end)
end

btnSpeed16.MouseButton1Click:Connect(function() applySpeed(16) end)
btnSpeed50.MouseButton1Click:Connect(function() applySpeed(50) end)
btnSpeed100.MouseButton1Click:Connect(function() applySpeed(100) end)

RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= currentSpeed then
                hum.WalkSpeed = currentSpeed
            end
        end
    end)
end)
