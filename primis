-- PART 1: SERVER-SIDE ANTI-CHEAT SYSTEM
-- =================================================================
if Services.RunService:IsServer() then
    local Config = {
        MaxSpeed = 22,
        MaxJump = 60,
        MaxDistancePerSec = 80
    }

    local PlayerData = {}

    local function OnPlayerAdded(player)
        PlayerData[player] = { LastPos = nil, LastTime = tick(), Warnings = 0 }

        player.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid", 10)
            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            if not hum or not hrp then return end

            PlayerData[player].LastPos = hrp.Position

            hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if hum.WalkSpeed > Config.MaxSpeed then hum.WalkSpeed = 16 end
            end)

            hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
                if hum.JumpPower > Config.MaxJump then hum.JumpPower = 50 end
            end)
        end)
    end

    Services.Players.PlayerAdded:Connect(OnPlayerAdded)
    Services.Players.PlayerRemoving:Connect(function(plr) PlayerData[plr] = nil end)

    Services.RunService.Heartbeat:Connect(function()
        for plr, data in pairs(PlayerData) do
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")

                if hum and hum.Health > 0 and data.LastPos then
                    local now = tick()
                    local dt = now - data.LastTime
                    if dt > 0.1 then
                        local dist = (hrp.Position - data.LastPos).Magnitude
                        local speed = dist / dt

                        if speed > Config.MaxDistancePerSec then
                            data.Warnings = data.Warnings + 1
                            if data.Warnings >= 4 then
                                plr:Kick("[2K13 Anti-Cheat]: Phát hiện dịch chuyển trái phép.")
                            else
                                hrp.CFrame = CFrame.new(data.LastPos)
                            end
                        else
                            if data.Warnings > 0 then data.Warnings = data.Warnings - 0.1 end
                        end
                        data.LastPos = hrp.Position
                        data.LastTime = now
                    end
                end
            end
        end
    end)
    print("[2K13 SERVER]: Anti-Cheat Engine Loaded!")
end

