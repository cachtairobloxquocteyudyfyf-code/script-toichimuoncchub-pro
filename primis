    -- Prompt Verification
    local function IsValidPrompt(prompt, keywords)
        if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local parentPart = prompt.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local dist = (hrp.Position - parentPart.Position).Magnitude
                if dist > Flags.MaxDistFilter then return false end
            end
        end

        local promptText = (prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name .. " " .. prompt.Parent.Name):lower()
        for _, kw in pairs(keywords) do
            if promptText:find(kw) then return true end
        end
        return false
    end

