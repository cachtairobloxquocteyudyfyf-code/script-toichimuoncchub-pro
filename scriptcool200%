-- Hàm tạo nút bấm tiện ích chung
local function createGenericBtn(parent, text, posX, posY, width, height, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, width, 0, height)
    btn.Position = UDim2.new(0, posX, 0, posY)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSans
    btn.Parent = parent
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    return btn
end

-- ==================== TAB MAIN CONTENT ====================
local function createCheckbox(parent, text, posY, getStateCallback, setStateCallback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 45, 0, 30)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(0, 168, 107)
    btn.Text = "✓ " .. text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        local newState = not getStateCallback()
        setStateCallback(newState)
        if newState then
            btn.BackgroundColor3 = Color3.fromRGB(0, 168, 107)
            btn.Text = "✓ " .. text
        else
            btn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            btn.Text = "X " .. text
        end
    end)
    return btn
end

