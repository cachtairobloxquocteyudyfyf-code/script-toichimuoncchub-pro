for _, group in ipairs(MusicGroups) do
    local CategoryLabel = Instance.new("TextLabel")
    CategoryLabel.Size = UDim2.new(1, -6, 0, 28)
    CategoryLabel.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
    CategoryLabel.Text = " " .. group.Category
    CategoryLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    CategoryLabel.TextSize = 10
    CategoryLabel.Font = Enum.Font.GothamBold
    CategoryLabel.TextXAlignment = Enum.TextXAlignment.Left
    CategoryLabel.Parent = ScrollingContainer
    Instance.new("UICorner", CategoryLabel).CornerRadius = UDim.new(0, 6)

    for _, song in ipairs(group.Songs) do
        local SongItem = Instance.new("Frame")
        SongItem.Size = UDim2.new(1, -6, 0, 34)
        SongItem.BackgroundColor3 = Color3.fromRGB(20, 25, 38)
        SongItem.Parent = ScrollingContainer
        Instance.new("UICorner", SongItem).CornerRadius = UDim.new(0, 6)

        local SongLabel = Instance.new("TextLabel")
        SongLabel.Size = UDim2.new(1, -75, 1, 0)
        SongLabel.Position = UDim2.new(0, 8, 0, 0)
        SongLabel.BackgroundTransparency = 1
        SongLabel.Text = song.Name
        SongLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        SongLabel.TextSize = 9
        SongLabel.Font = Enum.Font.Gotham
        SongLabel.TextXAlignment = Enum.TextXAlignment.Left
        SongLabel.Parent = SongItem

        local CopyBtn = Instance.new("TextButton")
        CopyBtn.Size = UDim2.new(0, 65, 0, 24)
        CopyBtn.Position = UDim2.new(1, -70, 0.5, -12)
        CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        CopyBtn.Text = "📋 COPY"
        CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        CopyBtn.TextSize = 9
        CopyBtn.Font = Enum.Font.GothamBold
        CopyBtn.Parent = SongItem
        Instance.new("UICorner", CopyBtn).CornerRadius = UDim.new(0, 4)

        -- Hàm Auto Copy ID vào Clipboard
        CopyBtn.MouseButton1Click:Connect(function()
            pcall(function()
                if setclipboard then
                    setclipboard(song.ID)
                end
            end)
            
            CopyBtn.Text = "COPIED!"
            CopyBtn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
            task.wait(1)
            CopyBtn.Text = "📋 COPY"
            CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        end)
    end
end

