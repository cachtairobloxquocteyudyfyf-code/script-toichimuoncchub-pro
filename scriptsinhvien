-- 5. Logic Joystick Fly + Nút UP/DOWN
btnFlyV2.MouseButton1Click:Connect(function()
    isFlyActive = not isFlyActive
    btnFlyV2.Text = isFlyActive and "Joystick Fly: ON" or "Joystick Fly: OFF"
    btnFlyV2.BackgroundColor3 = isFlyActive and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 100, 0)
    
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if isFlyActive then
        if hum then hum.PlatformStand = true end
        if flyConn then flyConn:Disconnect() end
        
        flyGyro = Instance.new("BodyGyro")
        flyGyro.P = 9e4
        flyGyro.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
        flyGyro.CFrame = hrp.CFrame
        flyGyro.Parent = hrp
        
        flyVel = Instance.new("BodyVelocity")
        flyVel.Velocity = Vector3.new(0, 0, 0)
        flyVel.MaxForce = Vector3.new(9e4, 9e4, 9e4)
        flyVel.Parent = hrp
        
        flyConn = RunService.RenderStepped:Connect(function()
            pcall(function()
                local cam = workspace.CurrentCamera
                if hrp and cam and flyVel and flyGyro then
                    flyGyro.CFrame = cam.CFrame
                    local moveDir = hum and hum.MoveDirection or Vector3.new(0,0,0)
                    local speed = 50
                    local yVel = 0.1
                    
                    if flyUpPressed then
                        yVel = speed
                    elseif flyDownPressed then
                        yVel = -speed
                    end
                    
                    if moveDir.Magnitude > 0 then
                        hrp.CFrame = hrp.CFrame + (moveDir * (speed * 0.05))
                    end
                    flyVel.Velocity = Vector3.new(0, yVel, 0)
                end
            end)
        end)
    else
        if flyConn then flyConn:Disconnect() flyConn = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
        if flyVel then flyVel:Destroy() flyVel = nil end
        if hum then hum.PlatformStand = false end
    end
end)

-- 6. Logic Blue ESP Player + Khoảng cách (m) + Cảnh báo Khổng Lồ
btnEspPlayer.MouseButton1Click:Connect(function()
    isEspPlayerActive = not isEspPlayerActive
    btnEspPlayer.Text = isEspPlayerActive and "Blue ESP: ON" or "Blue ESP: OFF"
    btnEspPlayer.BackgroundColor3 = isEspPlayerActive and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(0, 100, 200)
    
    task.spawn(function()
        while isEspPlayerActive do
            pcall(function()
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        local char = p.Character
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        
                        if hrp then
                            if not char:FindFirstChild("HL_BlueEsp") then
                                local hl = Instance.new("Highlight")
                                hl.Name = "HL_BlueEsp"
                                hl.Adornee = char
                                hl.FillColor = Color3.fromRGB(0, 120, 255)
                                hl.FillTransparency = 0.4
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.Parent = char
                            end
                            
                            local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                            local isGiant = (hrp.Size.Y > 3.5)
                            
                            local bg = hrp:FindFirstChild("BlueEspTag")
                            if not bg then
                                bg = Instance.new("BillboardGui")
                                bg.Name = "BlueEspTag"
                                bg.Size = UDim2.new(0, 140, 0, 50)
                                bg.StudsOffset = Vector3.new(0, 3.5, 0)
                                bg.AlwaysOnTop = true
                                bg.Parent = hrp
                                
                                local lbl = Instance.new("TextLabel")
                                lbl.Name = "EspText"
                                lbl.Size = UDim2.new(1, 0, 1, 0)
                                lbl.BackgroundTransparency = 1
                                lbl.TextColor3 = Color3.fromRGB(0, 180, 255)
                                lbl.TextSize = 12
                                lbl.Font = Enum.Font.SourceSansBold
                                lbl.TextStrokeTransparency = 0.5
                                lbl.Parent = bg
                            end
                            
                            local tagText = p.Name .. "\n" .. dist .. "m"
                            if isGiant then
                                tagText = "🔵 KHỔNG LỒ\n" .. p.Name .. " (" .. dist .. "m)"
                            end
                            
                            if bg:FindFirstChild("EspText") then
                                bg.EspText.Text = tagText
                                bg.EspText.TextColor3 = isGiant and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(100, 200, 255)
                            end
                        end
                    end
                end
            end)
            task.wait(0.5)
        end
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    if p.Character:FindFirstChild("HL_BlueEsp") then p.Character.HL_BlueEsp:Destroy() end
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp:FindFirstChild("BlueEspTag") then hrp.BlueEspTag:Destroy() end
                end
            end
        end)
    end)
end)

