-- Fly V3
FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if isFlying then
        FlyBtn.Text = "🕊️ [ON] Fly V3"
        FlyBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        StatusLbl.Text = "Trạng thái: Đang bay... 🕊️"
        
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1,1,1) * 1000000
        bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyVelocity.Parent = hrp
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1,1,1) * 1000000
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp
        
        flyConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                local cam = workspace.CurrentCamera
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and bodyVelocity and bodyGyro then
                    bodyGyro.CFrame = cam.CFrame
                    local md = hum.MoveDirection
                    bodyVelocity.Velocity = (cam.CFrame.LookVector * md.Z * -flySpeed) + (cam.CFrame.RightVector * md.X * flySpeed)
                end
            end)
        end)
    else
        FlyBtn.Text = "🕊️ [OFF] Fly V3"
        FlyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLbl.Text = "Trạng thái: Tắt Fly."
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end
end)

-- Tween Follow
TweenToggleBtn.MouseButton1Click:Connect(function()
    if not currentTargetPlayer then
        StatusLbl.Text = "Trạng thái: Chưa chọn Player! ⚠️"
        StatusLbl.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end
    
    isTweenRunning = not isTweenRunning
    if isTweenRunning then
        TweenToggleBtn.Text = "🎯 [ON] Tween Follow"
        TweenToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        StatusLbl.Text = "Trạng thái: Đang bám theo " .. currentTargetPlayer.Name
        
        tweenConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                if isTweenRunning and currentTargetPlayer and currentTargetPlayer.Character and currentTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHrp = currentTargetPlayer.Character.HumanoidRootPart
                        LocalPlayer.Character.HumanoidRootPart.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end)
    else
        TweenToggleBtn.Text = "🎯 [OFF] Tween Follow"
        TweenToggleBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLbl.Text = "Trạng thái: Đã dừng Tween."
        if tweenConnection then tweenConnection:Disconnect() tweenConnection = nil end
    end
end)

