-- ESP Player
EspBtn.MouseButton1Click:Connect(function()
    isEspRunning = not isEspRunning
    if isEspRunning then
        EspBtn.Text = _T("EspOn") EspBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        espConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = p.Character.HumanoidRootPart
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if not espDrawings[p] then
                            local text = Drawing.new("Text")
                            text.Visible = false text.Center = true text.Outline = true text.Size = 13 text.Color = Color3.fromRGB(0, 255, 150)
                            espDrawings[p] = text
                        end
                        local txtObj = espDrawings[p]
                        if onScreen and hum and hum.Health > 0 then
                            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                            txtObj.Text = string.format("%s [%d m]", p.Name, dist)
                            txtObj.Position = Vector2.new(vector.X, vector.Y - 20)
                            txtObj.Visible = true
                        else
                            txtObj.Visible = false
                        end
                    elseif espDrawings[p] then
                        espDrawings[p].Visible = false
                    end
                end
            end)
        end)
    else
        EspBtn.Text = _T("EspOff") EspBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        if espConnection then espConnection:Disconnect() espConnection = nil end
        for _, txt in pairs(espDrawings) do pcall(function() txt:Remove() end) end
        espDrawings = {}
    end
end)

