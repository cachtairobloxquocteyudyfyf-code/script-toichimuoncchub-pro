FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    if isFlying then
        FlyBtn.Text = "🕊️ [ON] Fly V3" FlyBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        bodyVelocity = Instance.new("BodyVelocity", hrp) bodyVelocity.MaxForce = Vector3.new(1,1,1)*1000000 bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyGyro = Instance.new("BodyGyro", hrp) bodyGyro.MaxTorque = Vector3.new(1,1,1)*1000000 bodyGyro.CFrame = hrp.CFrame
        flyConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                local cam = workspace.CurrentCamera local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and bodyVelocity and bodyGyro then
                    bodyGyro.CFrame = cam.CFrame local md = hum.MoveDirection
                    bodyVelocity.Velocity = (cam.CFrame.LookVector * md.Z * -flySpeed) + (cam.CFrame.RightVector * md.X * flySpeed)
                end
            end)
        end)
    else
        FlyBtn.Text = "🕊️ [OFF] Fly V3" FlyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy() end if bodyGyro then bodyGyro:Destroy() end
    end
end)

TweenToggleBtn.MouseButton1Click:Connect(function()
    if not currentTargetPlayer then return end
    isTweenRunning = not isTweenRunning
    if isTweenRunning then
        TweenToggleBtn.Text = "🎯 [ON] Tween Follow" TweenToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        tweenConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                if isTweenRunning and currentTargetPlayer and currentTargetPlayer.Character and currentTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = currentTargetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end)
    else
        TweenToggleBtn.Text = "🎯 [OFF] Tween Follow" TweenToggleBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        if tweenConnection then tweenConnection:Disconnect() tweenConnection = nil end
    end
end)

