-- 2. ĐỘNG CƠ QUÉT CHUYÊN SÂU REMOTE (DEEP SCAN REMOTE FINDER ENGINE)
--------------------------------------------------------------------------------------
local RemoteCache = {
    Truck = {},
    Rob = {},
    Sell = {},
    Repair = {},
    Cuff = {},
    Fuel = {}
}

local function ScanAllRemotes()
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = string.lower(obj.Name)
            
            if string.find(name, "truck") or string.find(name, "delivery") or string.find(name, "job") or string.find(name, "cargo") then
                table.insert(RemoteCache.Truck, obj)
            end
            if string.find(name, "rob") or string.find(name, "register") or string.find(name, "steal") or string.find(name, "vault") then
                table.insert(RemoteCache.Rob, obj)
            end
            if string.find(name, "sell") or string.find(name, "cash") or string.find(name, "collect") or string.find(name, "deposit") then
                table.insert(RemoteCache.Sell, obj)
            end
            if string.find(name, "repair") or string.find(name, "fix") then
                table.insert(RemoteCache.Repair, obj)
            end
            if string.find(name, "cuff") or string.find(name, "arrest") or string.find(name, "tase") then
                table.insert(RemoteCache.Cuff, obj)
            end
        end
    end
end

ScanAllRemotes()

