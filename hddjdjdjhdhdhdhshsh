-- 1. TÌM TARGET PLAYER
TargetBox:GetPropertyChangedSignal("Text"):Connect(function()
    pcall(function()
        local textName = string.lower(TargetBox.Text)
        if textName == "" then currentTargetPlayer = nil return end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (string.find(string.lower(p.Name), textName) or string.find(string.lower(p.DisplayName), textName)) then
                currentTargetPlayer = p
                StatusLbl.Text = "Đã chọn: " .. p.Name
                break
            end
        end
    end)
end)

ResetPlayerTargetBtn.MouseButton1Click:Connect(function()
    TargetBox.Text = "" currentTargetPlayer = nil
    if isTweenRunning then isTweenRunning = false TweenToggleBtn.Text = "🎯 [OFF] Tween Follow" TweenToggleBtn.TextColor3 = Color3.fromRGB(255,80,80) if tweenConnection then tweenConnection:Disconnect() end end
    if isAutoTpRunning then isAutoTpRunning = false AutoTpBtn.Text = "🔄 [OFF] Auto TP Loop" AutoTpBtn.TextColor3 = Color3.fromRGB(255,80,80) if autoTpConnection then autoTpConnection:Disconnect() end end
    StatusLbl.Text = "Đã xóa mục tiêu!"
end)

-- 2. TWEEN FOLLOW & AUTO TP LOOP
TweenToggleBtn.MouseButton1Click:Connect(function()
    if not currentTargetPlayer then StatusLbl.Text = "Chưa nhập tên Player!" return end
    isTweenRunning = not isTweenRunning
    if isTweenRunning then
        TweenToggleBtn.Text = "🎯 [ON] Tween Follow" TweenToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        tweenConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                if currentTargetPlayer and currentTargetPlayer.Character and currentTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = currentTargetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end)
    else
        TweenToggleBtn.Text = "🎯 [OFF] Tween Follow" TweenToggleBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
        if tweenConnection then tweenConnection:Disconnect() end
    end
end)

AutoTpBtn.MouseButton1Click:Connect(function()
    if not currentTargetPlayer then StatusLbl.Text = "Chưa nhập tên Player!" return end
    isAutoTpRunning = not isAutoTpRunning
    if isAutoTpRunning then
        AutoTpBtn.Text = "🔄 [ON] Auto TP Loop" AutoTpBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
        task.spawn(function()
            while isAutoTpRunning do
                pcall(function()
                    if currentTargetPlayer and currentTargetPlayer.Character and currentTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = currentTargetPlayer.Character.HumanoidRootPart.CFrame
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    else
        AutoTpBtn.Text = "🔄 [OFF] Auto TP Loop" AutoTpBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

