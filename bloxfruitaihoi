local function SafeMoveTo(targetCFrame, customSpeed)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
        return 
    end
    
    local HRP = LocalPlayer.Character.HumanoidRootPart
    local speed = customSpeed or SafeTweenSpeed
    local distance = (targetCFrame.Position - HRP.Position).Magnitude
    
    if distance < 12 then
        HRP.CFrame = targetCFrame
        return
    end
    
    local timeToTravel = distance / speed
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    
    if CurrentTween then 
        CurrentTween:Cancel() 
    end
    
    CurrentTween = TweenService:Create(HRP, tweenInfo, {CFrame = targetCFrame})
    CurrentTween:Play()
    return CurrentTween
end

local function EquipTargetWeapon(weaponCategory)
    if not LocalPlayer.Character then 
        return 
    end
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    if not Backpack then 
        return 
    end
    
    for _, tool in pairs(Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if weaponCategory == "Melee" and tool.ToolTip == "Melee" then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                break
            elseif weaponCategory == "Sword" and tool.ToolTip == "Sword" then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                break
            elseif weaponCategory == "Blox Fruit" and tool.ToolTip == "Blox Fruit" then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                break
            elseif weaponCategory == "Gun" and tool.ToolTip == "Gun" then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

local function CheckAntiStuckSystem()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local currentPos = LocalPlayer.Character.HumanoidRootPart.Position
    local distMoved = (currentPos - LastPlayerPosition).Magnitude
    
    if AutoFarmLevel and distMoved < 2 then
        AntiStuckTimer = AntiStuckTimer + 1
        if AntiStuckTimer > 15 then
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest")
            end)
            AntiStuckTimer = 0
        end
    else
        AntiStuckTimer = 0
    end
    LastPlayerPosition = currentPos
end

local function BringMobsToPoint(targetCFrame, radius)
    if not BringMob then return end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end
    
    for _, enemy in pairs(enemiesFolder:GetChildren()) do
        if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
            if enemy.Humanoid.Health > 0 then
                local dist = (enemy.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
                if dist <= (radius or 300) then
                    enemy.HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 0, -2)
                    enemy.HumanoidRootPart.CanCollide = false
                    enemy.Humanoid.WalkSpeed = 0
                end
            end
        end
    end
end

