-- Vòng lặp cập nhật thời gian, Ping và FPS
local scriptStartTime = tick()
task.spawn(function()
    while true do
        pcall(function()
            local elapsed = math.floor(tick() - scriptStartTime)
            ScriptTimeLabel.Text = string.format("⏱️ Time: %02d:%02d:%02d", math.floor(elapsed/3600), math.floor((elapsed%3600)/60), elapsed%60)
            
            local pingMs = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            local fpsVal = math.floor(1 / RunService.RenderStepped:Wait())
            NetworkStatsLabel.Text = string.format("📡 Ping: %d ms | 🖥️ FPS: %d", pingMs, fpsVal)
        end)
        task.wait(1)
    end
end)

