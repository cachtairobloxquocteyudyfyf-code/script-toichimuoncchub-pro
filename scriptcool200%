-- Spectate Player
btnSpec.MouseButton1Click:Connect(function()
    local targetName = specBox.Text:lower()
    local foundTarget = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #targetName) == targetName or p.DisplayName:lower():sub(1, #targetName) == targetName then
            foundTarget = p
            break
        end
    end

    if not foundTarget and not isSpectating then
        btnSpec.Text = "Không thấy!"
        task.wait(1)
        btnSpec.Text = "Spectate: TẮT"
        return
    end

    isSpectating = not isSpectating
    if isSpectating and foundTarget then
        spectatingTarget = foundTarget
        btnSpec.Text = "Đang xem"
        btnSpec.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
        
        task.spawn(function()
            while isSpectating and spectatingTarget and spectatingTarget.Character and spectatingTarget.Character:FindFirstChild("Humanoid") do
                workspace.CurrentCamera.CameraSubject = spectatingTarget.Character.Humanoid
                RunService.RenderStepped:Wait()
            end
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
            end
        end)
    else
        isSpectating = false
        spectatingTarget = nil
        btnSpec.Text = "Spectate: TẮT"
        btnSpec.BackgroundColor3 = Color3.fromRGB(180, 100, 0)
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            workspace.CurrentCamera.CameraSubject = player.Character.Humanoid
        end
    end
end)

